generator client {
  provider = "prisma-client-js"
}

// npx prisma migrate dev --name add_customer_table 
// npx prisma generate 

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  username    String
  email       String   @unique
  designation String?
  password    String
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Expense {
  id        String   @id @default(uuid())
  title     String
  amount    Float
  category  String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stock {
  id Int @id @default(autoincrement())

  // Core identity
  name String
  code String @unique
  type String // frame, lens, accessory, etc.

  // Quantities
  qty  Int
  sold Int @default(0)

  // Pricing
  priceUsd Decimal  @db.Decimal(10, 2)
  priceKsh Decimal  @db.Decimal(10, 2)
  appPrice Decimal? @db.Decimal(10, 2)

  // Costing
  costUsd       Decimal? @db.Decimal(10, 2)
  costKsh       Decimal? @db.Decimal(10, 2)
  prevCostPb    Decimal? @db.Decimal(10, 2)
  profitPerBale Decimal? @db.Decimal(10, 2)

  // Procurement
  bought  DateTime?
  etr     DateTime?
  fob     Decimal?  @db.Decimal(10, 2)
  loading Decimal?  @db.Decimal(10, 2)

  supplier String?
  notes    String?

  imageUrl String?

  // Relations
  saleItems SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Patient {
  id        Int       @id @default(autoincrement())
  firstName String
  lastName  String
  email     String?   @unique
  phone     String
  dob       DateTime?
  gender    String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Order {
  id               Int       @id @default(autoincrement())
  supplierName     String
  supplierEmail    String?
  supplierPhone    String?
  lensType         String // single, progressive, bifocal
  material         String // polycarbonate, high-index, plastic
  coating          String? // AR, photochromic, blue-light
  quantityOrdered  Int
  quantityReceived Int       @default(0)
  landedCost       Float // total landed cost per lens
  orderDate        DateTime  @default(now())
  expectedArrival  DateTime?
  receivedDate     DateTime?
  status           String // pending, shipped, partial, received
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Sale {
  id         Int      @id @default(autoincrement())
  customerId Int
  total      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer   @relation(fields: [customerId], references: [id])
  items    SaleItem[]
}

model SaleItem {
  id       Int   @id @default(autoincrement())
  saleId   Int
  stockId  Int
  quantity Int
  price    Float

  sale  Sale  @relation(fields: [saleId], references: [id])
  stock Stock @relation(fields: [stockId], references: [id])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  type      String // "patient", "company", "outlet"
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}
