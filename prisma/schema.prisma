generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model customer {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt  // Added @updatedAt
  sale      sale[]
}

model expense {
  id        String   @id @default(cuid())
  title     String
  amount    Float
  category  String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt  // Added @updatedAt
}

model order {
  id               Int       @id @default(autoincrement())
  code             String    // Will be "AUTO" or an existing code
  name             String    // Required to create/update stock
  type             String    // Required to create/update stock
  supplierName     String
  supplierEmail    String?
  supplierPhone    String?
  
  quantityOrdered  Decimal   @db.Decimal(10, 2)
  quantityReceived Decimal   @default(0) @db.Decimal(10, 2)

  landedCost       Decimal   @db.Decimal(10, 2) 
  priceKsh         Decimal   @default(0) @db.Decimal(10, 2)
  priceUsd         Decimal   @default(0) @db.Decimal(10, 2)

  sph              Decimal?  @db.Decimal(4, 2) 
  cyl              Decimal?  @db.Decimal(4, 2)

  orderDate        DateTime  @default(now())
  expectedArrival  DateTime?
  receivedDate     DateTime?
  status           String    @default("pending") 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model patient {
  id        Int       @id @default(autoincrement())
  firstName String
  lastName  String
  email     String?   @unique(map: "Patient_email_key")
  phone     String
  dob       DateTime?
  gender    String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt  // Added @updatedAt
  jobcards  jobcard[]
  sales      sale[]
}

model sale {
  id         Int        @id @default(autoincrement())
  
  //customerId optional (?)
  customerId Int?       
  customer   customer?  @relation(fields: [customerId], references: [id], map: "Sale_customerId_fkey")
  
  // Add optional patient relation
  patientId  Int?       
  patient    patient?   @relation(fields: [patientId], references: [id])

  total      Float
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt  // Added @updatedAt
  saleitem   saleitem[]

  @@index([customerId], map: "Sale_customerId_fkey")
}

model saleitem {
  id       Int   @id @default(autoincrement())
  saleId   Int
  stockId  Int
  quantity Decimal @db.Decimal(10, 2) // Changed from Int to Decimal
  price    Float
  sale     sale  @relation(fields: [saleId], references: [id], map: "SaleItem_saleId_fkey")
  stock    stock @relation(fields: [stockId], references: [id], map: "SaleItem_stockId_fkey")

  @@index([saleId], map: "SaleItem_saleId_fkey")
  @@index([stockId], map: "SaleItem_stockId_fkey")
}

model stock {
  id            Int        @id @default(autoincrement())
  type          String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt  // Added @updatedAt
  appPrice      Decimal?   @db.Decimal(10, 2)
  bought        DateTime?
  code          String     @unique(map: "Stock_code_key")
  costKsh       Decimal?   @db.Decimal(10, 2)
  costUsd       Decimal?   @db.Decimal(10, 2)
  etr           DateTime?
  fob           Decimal?   @db.Decimal(10, 2)
  loading       Decimal?   @db.Decimal(10, 2)
  name          String
  notes         String?
  prevCostPb    Decimal?   @db.Decimal(10, 2)
  priceKsh      Decimal    @db.Decimal(10, 2)
  priceUsd      Decimal    @db.Decimal(10, 2)
  profitPerBale Decimal?   @db.Decimal(10, 2)
  qty           Decimal    @default(0) @db.Decimal(10, 2)
  supplier      String?

  // Lens Specific Fields (Optional for Frames)
  sph           Decimal?   @db.Decimal(4, 2) 
  cyl           Decimal?   @db.Decimal(4, 2)
  
  isDeleted Boolean  @default(false)
  saleitem      saleitem[]
}

model supplier {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt  // Added @updatedAt
}

model user {
  id          Int      @id @default(autoincrement())
  username    String
  email       String   @unique(map: "User_email_key")
  designation String?
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt  // Added @updatedAt
  phone       String?
}

model jobcard {
  id               Int      @id @default(autoincrement())
  jobCardNumber    String   @unique // The red number "1419"
  patientId        Int
  patient          patient  @relation(fields: [patientId], references: [id])
  insuranceCompany String?
  date             DateTime @default(now())
  
  // Right Eye (OD)
  rSph             Decimal? @db.Decimal(4, 2)
  rCyl             Decimal? @db.Decimal(4, 2)
  rAxis            Int?
  rPrism           String?
  rBase            String?

  // Left Eye (OS)
  lSph             Decimal? @db.Decimal(4, 2)
  lCyl             Decimal? @db.Decimal(4, 2)
  lAxis            Int?
  lPrism           String?
  lBase            String?

  nearAdd          String?
  distPd           String?
  nearPd           String?
  heights          String?
  lenses           String?
  lensQty          Decimal? @default(1.0) @db.Decimal(4, 2)
  frame            String?
  frameQty         Int?     @default(1)

  frameStockId     Int?
  lensStockId      Int?

  // Financials
  total            Decimal  @default(0) @db.Decimal(10, 2)
  advance          Decimal  @default(0) @db.Decimal(10, 2)
  balance          Decimal  @default(0) @db.Decimal(10, 2)
  jobDelDate       DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([patientId])
}