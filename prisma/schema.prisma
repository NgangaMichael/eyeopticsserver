generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "debian-openssl-1.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "rhel-openssl-1.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model customer {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt  // Added @updatedAt
  sale      sale[]
}

model expense {
  id        String   @id @default(cuid())
  title     String
  amount    Float
  category  String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt  // Added @updatedAt
}

model patient {
  id        Int       @id @default(autoincrement())
  firstName String
  lastName  String
  email     String?   @unique(map: "Patient_email_key")
  phone     String
  dob       DateTime?
  gender    String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt  // Added @updatedAt
  jobcards  jobcard[]
  sales      sale[]
}

model sale {
  id              Int        @id @default(autoincrement())
  
  customerId      Int?       
  customer        customer?  @relation(fields: [customerId], references: [id], map: "Sale_customerId_fkey")
  
  patientId       Int?       
  // patient         patient?   @relation(fields: [patientId], references: [id])
  patient         patient?  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  referenceNumber String?    @unique

  // New Fields
  etimsReceipt    String?    // eTIMS Receipt Number
  etimsAmount     Decimal?   @db.Decimal(10, 2) // Amount recorded in eTIMS

  total           Float
  discount        Float      @default(0)
  miscellaneous   Float      @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  saleitem        saleitem[]

  @@index([customerId], map: "Sale_customerId_fkey")
}

model container {
  id           Int             @id @default(autoincrement())
  code         String          @unique
  name         String
  createdBy    String
  supplierName String
  status       String          @default("pending")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  items        containerItem[]
}

model containerItem {
  id            Int        @id @default(autoincrement())
  containerId   Int
  container     container  @relation(fields: [containerId], references: [id])
  name          String
  code          String
  type          String
  index         String?
  lensCategory  String?
  sph           Decimal?   @db.Decimal(4, 2)
  cyl           Decimal?   @db.Decimal(4, 2)
  axis          Int?
  nearAdd       Decimal?   @db.Decimal(4, 2)
  quantityOrdered Decimal  @db.Decimal(10, 2)
  landedCost    Decimal    @db.Decimal(10, 2)
  wholesalePrice Decimal? @db.Decimal(10, 2)
  priceKsh      Decimal    @default(0) @db.Decimal(10, 2)
  priceUsd      Decimal    @default(0) @db.Decimal(10, 2)
  costKsh      Decimal    @default(0) @db.Decimal(10, 2)
  createdAt     DateTime   @default(now())
}

model saleitem {
  id       Int     @id @default(autoincrement())
  saleId   Int
  stockId  Int
  quantity Decimal @db.Decimal(10, 2)
  price    Float

  // FIX: Add 'onDelete: Cascade' here
  sale     sale    @relation(fields: [saleId], references: [id], map: "SaleItem_saleId_fkey", onDelete: Cascade)
  
  stock    stock   @relation(fields: [stockId], references: [id], map: "SaleItem_stockId_fkey")

  @@index([saleId], map: "SaleItem_saleId_fkey")
  @@index([stockId], map: "SaleItem_stockId_fkey")
}

model stock {
  id            Int        @id @default(autoincrement())
  type          String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt  // Added @updatedAt
  appPrice      Decimal?   @db.Decimal(10, 2)
  bought        DateTime?
  code          String     @unique(map: "Stock_code_key")
  costKsh       Decimal?   @db.Decimal(10, 2)
  costUsd       Decimal?   @db.Decimal(10, 2)
  etr           DateTime?
  fob           Decimal?   @db.Decimal(10, 2)
  loading       Decimal?   @db.Decimal(10, 2)
  landedCost       Decimal?   @db.Decimal(10, 2)
  name          String
  notes         String?
  prevCostPb    Decimal?   @db.Decimal(10, 2)
  priceKsh      Decimal    @db.Decimal(10, 2)
  priceUsd      Decimal    @db.Decimal(10, 2)
  profitPerBale Decimal?   @db.Decimal(10, 2)
  qty           Decimal    @default(0) @db.Decimal(10, 2)
  supplier      String?

  index          String?
  wholesalePrice Decimal?   @db.Decimal(10, 2)

  // Lens Specific Fields (Optional for Frames)
  sph           Decimal?   @db.Decimal(4, 2) 
  cyl           Decimal?   @db.Decimal(4, 2)
  axis         Int?     // For lenses
  nearAdd      Decimal? @db.Decimal(4, 2) // For lenses
  lensCategory String?  // "Stock" or "Custom"
  
  isDeleted Boolean  @default(false)
  saleitem      saleitem[]

  @@index([isDeleted, createdAt])
  @@index([name])
  @@index([code])
}

model supplier {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt  // Added @updatedAt
}

model user {
  id          Int      @id @default(autoincrement())
  username    String
  email       String   @unique(map: "User_email_key")
  designation String?
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt  // Added @updatedAt
  phone       String?
}

model jobcard {
  id               Int      @id @default(autoincrement())
  jobCardNumber    String   @unique
  patientId        Int
  // patient          patient  @relation(fields: [patientId], references: [id])
  patient          patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  insuranceCompany String?
  notes            String?
  date             DateTime @default(now())
  
  // Right Eye (OD)
  rSph             Decimal? @db.Decimal(4, 2)
  rCyl             Decimal? @db.Decimal(4, 2)
  rAxis            Int?
  rPrism           String?
  rBase            String?
  rLens            String?  
  rLensStockId     Int?     
  rLensPrice       Decimal? @default(0) @db.Decimal(10, 2)

  // Left Eye (OS)
  lSph             Decimal? @db.Decimal(4, 2)
  lCyl             Decimal? @db.Decimal(4, 2)
  lAxis            Int?
  lPrism           String?
  lBase            String?
  lLens            String?  
  lLensStockId     Int?     
  lLensPrice       Decimal? @default(0) @db.Decimal(10, 2)

  // Shared Specs
  nearAdd          String?
  distPd           String?
  nearPd           String?
  heights          String?

  // Frames
  frame            String?
  frameQty         Int?     @default(1)
  framePrice       Decimal? @default(0) @db.Decimal(10, 2)
  frameStockId     Int?

  // Financials
  total            Decimal  @default(0) @db.Decimal(10, 2)
  consultation     Decimal  @default(0) @db.Decimal(10, 2)
  discount         Decimal  @default(0) @db.Decimal(10, 2)
  advance          Decimal  @default(0) @db.Decimal(10, 2)
  balance          Decimal  @default(0) @db.Decimal(10, 2)
  jobDelDate       DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([patientId])
}